{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgriciDaniel/deepseek-harness-brain/blob/main/references/schemas/release-status.schema.json",
  "title": "DeepSeek Harness Brain release status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "as_of",
    "release_version",
    "distribution_target",
    "knowledge_maturity",
    "human_publication_decision",
    "repository_reviewed_at",
    "market_ready",
    "repository_review",
    "decision",
    "verified_release_evidence",
    "unverified_runtime_tiers"
  ],
  "properties": {
    "schema": {"const": "deepseek-harness-brain.release-status.v2"},
    "as_of": {"type": "string", "format": "date"},
    "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "distribution_target": {"const": "community-ready"},
    "knowledge_maturity": {"const": "demo-verified"},
    "human_publication_decision": {"enum": ["pending", "approved", "declined"]},
    "repository_reviewed_at": {"type": "string", "format": "date"},
    "market_ready": {"type": "boolean"},
    "repository_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions_permissions", "branch_protection", "required_ci", "codeowners", "security_policy", "private_reporting_plan"],
      "properties": {
        "actions_permissions": {"const": true},
        "branch_protection": {"const": true},
        "required_ci": {"const": true},
        "codeowners": {"const": true},
        "security_policy": {"const": true},
        "private_reporting_plan": {"const": true}
      }
    },
    "decision": {"type": "string", "minLength": 1},
    "verified_release_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "unverified_runtime_tiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
