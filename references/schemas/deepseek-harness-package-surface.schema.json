{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deepseek-harness-package-surface.schema.json",
  "title": "DeepSeek Harness portability subsystem",
  "type": "object",
  "required": ["id", "name", "rank", "confidence", "minimal_slice", "recommendation", "evidence_paths"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "rank": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence": {"enum": ["evidence-based", "practitioner", "contested", "folklore"]},
    "minimal_slice": {"type": "string", "minLength": 1},
    "recommendation": {"type": "string", "minLength": 1},
    "evidence_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": true
}
